---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Expertos from '../components/Expertos.astro';
import Servicios from '../components/Servicios.astro';
import Niveles from '../components/Niveles.astro';
import Proceso from '../components/Proceso.astro';
import Principio from '../components/Principio.astro';
import CoreX from '../components/CoreX.astro';
import Fundadores from '../components/Fundadores.astro';
import Equipo from '../components/Equipo.astro';
import Enfoque from '../components/Enfoque.astro';
import Ecosistema from '../components/Ecosistema.astro';
import Preguntas from '../components/Preguntas.astro';
import Carrera from '../components/Carrera.astro';
import Comienza from '../components/Comienza.astro';
import Footer from '../components/Footer.astro';
import IncNav from '../components/inc/IncNav.astro';
import IncFooter from '../components/inc/IncFooter.astro';
import { LAYOUT } from '../config/layout';
---

<Base
  title="Revolution Wealth · Asesoría patrimonial personalizada"
  description="Habla con un asesor financiero certificado de Revolution Wealth y agenda tu primera sesión de estrategia. Tus recursos siempre en tu propia cuenta de GBM."
>
  {LAYOUT === 'inc' ? <IncNav /> : <Nav />}
  <main>
    <Hero />
    <Expertos />
    <Servicios />
    <Niveles />
    <Proceso />
    <Principio />
    <CoreX />
    <Fundadores />
    <Equipo />
    <Enfoque />
    <Ecosistema />
    <Preguntas />
    <Carrera />
    <Comienza />
  </main>
  {LAYOUT === 'inc' ? <IncFooter /> : <Footer />}
</Base>
