---
import { u } from '../config/base';
import Kicker from './Kicker.astro';
import Title from './Title.astro';
import Button from './Button.astro';
import Credentials from './Credentials.astro';
import { hero } from '../data/wealth';
---

<section class="hero theme-dark" aria-labelledby="hero-title">
  <div class="hero__top">
    <!-- Foto enmarcada (Figma: "Fondo · campo"), con velos, resplandores y grano -->
    <div class="hero__frame" aria-hidden="true">
      <img
        class="hero__photo"
        src={u('/img/fondo-campo-1600.webp')}
        srcset={u('/img/fondo-campo-900.webp') + ' 900w' + ", " + u('/img/fondo-campo-1600.webp') + ' 1600w'}
        sizes="100vw"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
        data-parallax="0.08"
      />
      <div class="hero__veil hero__veil--read"></div>
      <div class="hero__veil hero__veil--side"></div>
      <div class="hero__veil hero__veil--bottom"></div>
      <div class="hero__grain"></div>
    </div>
    <img class="hero__glow hero__glow--r" src={u('/img/resplandor-hero-der.svg')} alt="" aria-hidden="true" />

    <div class="container hero__content">
      <Kicker text={hero.kicker} />
      <Title lines={hero.title} as="h1" size="h1" class="hero__title" />

      <div class="hero__row">
        <div class="hero__lede" data-reveal>
          <p class="hero__lead" id="hero-title">{hero.lede}</p>
          <p class="hero__body">{hero.body}</p>
          <div class="hero__ctas">
            <Button href={hero.primary.href} label={hero.primary.label} />
            <Button href={hero.secondary.href} label={hero.secondary.label} variant="tertiary" />
          </div>
        </div>

        <aside class="session" aria-label={hero.session.title} data-reveal>
          <p class="session__head">
            <img src={u('/img/punto-dorado.svg')} alt="" width="7" height="7" />
            {hero.session.title}
          </p>
          <ol class="session__steps">
            {
              hero.session.steps.map((s, i) => (
                <li class="session__step" style={`--s: ${i}`}>
                  <span class="session__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="session__txt">
                    <span class="session__title">{s.title}</span>
                    <span class="session__text">{s.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="session__foot" style="--s: 3">
            {hero.session.footer.map((f) => <span>{f}</span>)}
          </p>
        </aside>
      </div>
    </div>
  </div>

  <img class="hero__glow hero__glow--l" src={u('/img/resplandor-hero-izq.svg')} alt="" aria-hidden="true" />
  <div class="container">
    <Credentials items={hero.credentials} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--nav-h);
    padding-bottom: 64px;
  }
  .hero__top {
    position: relative;
  }
  .hero__frame {
    position: absolute;
    inset: 1px 16px 0;
    z-index: -2;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    /* Bordes difuminados: la foto se funde con el fondo en vez de cortarse en seco.
       Abajo se desvanece en el último 30 %; a los lados y arriba, un margen corto. */
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0, #000 6%, #000 68%, transparent 100%),
      linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, transparent 0, #000 6%, #000 68%, transparent 100%),
      linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-composite: intersect;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
  }
  .hero__veil--read {
    background: linear-gradient(90deg, rgba(10, 10, 10, 0.78), rgba(10, 10, 10, 0.38) 45%, rgba(10, 10, 10, 0));
  }
  .hero__veil--side {
    opacity: 0.25;
    background: linear-gradient(90deg, rgba(10, 10, 10, 0.82), rgba(10, 10, 10, 0.35) 55%, rgba(10, 10, 10, 0));
  }
  .hero__veil--bottom {
    opacity: 0.25;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.2), rgba(10, 10, 10, 0) 40%, rgba(11, 15, 22, 0.92));
  }
  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    mix-blend-mode: overlay;
    background: url('/img/grano.png') top left / 50px 50px;
  }
  /* Resplandores azules (SVG de Figma, ya traen su desenfoque) */
  .hero__glow {
    position: absolute;
    z-index: -1;
    max-width: none;
    pointer-events: none;
  }
  .hero__glow--r {
    width: 1240px;
    left: calc(50% + 730px - 800px);
    top: -110px;
  }
  .hero__glow--l {
    width: 1260px;
    left: calc(50% - 380px - 800px);
    top: 520px;
    z-index: -3;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding-top: 49px;
  }
  .hero__title {
    max-width: 1260px;
    color: var(--paper);
    /* Sombra de Figma (5 capas de text-shadow) como filtro sobre el titular completo:
       con animaciones, cada renglón va recortado y el text-shadow saldría cortado. */
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18)) drop-shadow(0 4px 24px rgba(0, 0, 0, 0.3));
  }

  .hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    width: 100%;
    padding: 24px 0 56px;
  }
  .hero__lede {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 700px;
  }
  .hero__lead {
    font-family: var(--f-body);
    font-weight: 700;
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.875rem); /* 30/38 */
    line-height: 1.267;
    color: var(--paper);
  }
  .hero__body {
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem); /* 20/30 */
    line-height: 1.5;
    color: var(--silver);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    padding-top: 20px;
  }

  /* Tarjeta de vidrio: "Tu primera sesión de estrategia" */
  .session {
    flex: none;
    width: 600px;
    padding: 32px 40px;
    border: 1px solid rgba(164, 194, 212, 0.35);
    border-radius: var(--radius);
    background: linear-gradient(144.8deg, rgba(164, 194, 212, 0.16), rgba(156, 189, 209, 0.05));
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
  }
  .session__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 22px;
    font-family: var(--f-mono);
    font-size: 15px;
    line-height: 17px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .session__step {
    display: flex;
    gap: 24px;
    padding-block: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .session__num {
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 17px;
    letter-spacing: 0.05em;
    color: var(--steel);
  }
  .session__txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .session__title {
    font-size: var(--t-base);
    line-height: 28px;
    color: var(--paper);
  }
  .session__text {
    font-size: var(--t-small);
    line-height: 25px;
    color: var(--mist);
  }
  .session__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 17px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--mist);
  }

  /* ——— Llegada (solo con animaciones) ———
     1) La foto entra con un acercamiento lento: de 1.22 a la escala base 1.12 del parallax.
     2) Bajada y botones aparecen después del titular.
     3) Los tres pasos de "Tu primera sesión" llegan uno por uno, como el proceso que describen. */
  :global(html.motion) .hero__photo {
    animation: hero-push 2.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @media (max-width: 767px) {
    /* En celular no hay parallax: el acercamiento termina en el tamaño real */
    :global(html.motion) .hero__photo {
      animation-name: hero-push-m;
    }
  }
  @keyframes hero-push-m {
    from {
      scale: 1.1;
      opacity: 0.4;
    }
    to {
      scale: 1;
      opacity: 1;
    }
  }
  @keyframes hero-push {
    from {
      scale: 1.22;
      opacity: 0.4;
    }
    to {
      scale: 1.12;
      opacity: 1;
    }
  }
  :global(html.motion) .hero__lede {
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.9s var(--ease-out) 0.45s,
      translate 1s var(--ease-out) 0.45s;
  }
  :global(html.motion) .hero__lede.is-in {
    opacity: 1;
    translate: none;
  }
  :global(html.motion) .session {
    opacity: 0;
    translate: 0 24px;
    transition:
      opacity 0.9s var(--ease-out) 0.6s,
      translate 1s var(--ease-out) 0.6s;
  }
  :global(html.motion) .session__step,
  :global(html.motion) .session__foot {
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.7s var(--ease-out),
      translate 0.8s var(--ease-out);
    transition-delay: calc(0.95s + var(--s, 0) * 180ms);
  }
  :global(html.motion) .session.is-in,
  :global(html.motion) .session.is-in .session__step,
  :global(html.motion) .session.is-in .session__foot {
    opacity: 1;
    translate: none;
  }

  @media (max-width: 1180px) {
    .hero__row {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
      padding-top: 8px;
    }
    .session {
      width: 100%;
      max-width: 600px;
    }
  }
  @media (max-width: 600px) {
    .hero__frame {
      inset-inline: 8px;
      border-radius: 16px;
    }
    .hero__content {
      padding-top: 36px;
    }
    .hero__row {
      padding-bottom: 32px;
    }
    .session {
      padding: 24px 20px;
    }
    .session__head {
      font-size: 13px;
    }
    .hero__ctas :global(.btn--primary) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
