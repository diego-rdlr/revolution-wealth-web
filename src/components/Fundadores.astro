---
// 07 · Fundadores (Figma 425:541). Sección oscura: encabezado + 3 tarjetas con
// foto, cargo, nombre y trayectoria. Resplandores azules y grano como en Figma.
// Con animaciones activas las tarjetas suben en cascada y la foto se acerca un poco.
import Kicker from './Kicker.astro';
import Title from './Title.astro';
import { fundadores } from '../data/wealth';
---

<section id="fundadores" class="section theme-dark founders" aria-labelledby="fundadores-title">
  <div class="atmos" aria-hidden="true">
    <img class="founders__glow founders__glow--l" src="/img/fundadores-resplandor-izq.svg" alt="" />
    <img class="founders__glow founders__glow--r" src="/img/fundadores-resplandor-der.svg" alt="" />
    <div class="atmos__grain founders__grain"></div>
  </div>

  <div class="container">
    <header class="founders__head">
      <div class="founders__titular">
        <Kicker text={fundadores.kicker} />
        <div id="fundadores-title">
          <Title lines={fundadores.title} class="founders__title" />
        </div>
      </div>
      <p class="founders__body">{fundadores.body}</p>
    </header>

    <ul class="founders__grid" data-reveal>
      {
        fundadores.people.map((p, i) => (
          <li class="person" style={`--i: ${i}`}>
            <div class="person__photo">
              <img src={p.photo} alt={p.name} width="464" height="500" loading="lazy" decoding="async" />
            </div>
            <div class="person__text">
              <p class="person__role">{p.role}</p>
              <h3 class="person__name">{p.name}</h3>
              <ul class="person__points">
                {p.points.map((pt) => (
                  <li>{pt}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .founders {
    /* Figma: degradado vertical azul noche → negro (#1b2433 y #0e131b no están en tokens) */
    background: linear-gradient(180deg, #1b2433 0%, #0e131b 55%, var(--ink) 100%);
    padding-block: clamp(4.5rem, 2.5rem + 6.5vw, 9.375rem); /* 150 */
  }
  /* Resplandores: SVG de 1000×900 y 800×600 con 170 px de margen para el desenfoque */
  .founders__glow {
    position: absolute;
    max-width: none;
    height: auto;
  }
  .founders__glow--l {
    width: 1340px;
    left: calc(50% - 800px - 420px);
    top: 80px;
  }
  .founders__glow--r {
    width: 1140px;
    left: calc(50% - 800px + 830px);
    top: -370px;
  }
  .founders__grain {
    opacity: 0.05;
  }

  .founders__head {
    display: flex;
    align-items: flex-end;
    gap: 120px;
    margin-bottom: 72px;
  }
  .founders__titular {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .founders__titular :global(.founders__title) {
    max-width: 700px;
  }
  .founders__body {
    flex: none;
    width: 560px;
    font-size: var(--t-base);
    line-height: 28px;
    color: var(--body);
  }

  .founders__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .person {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(164, 194, 212, 0.16);
    border-radius: var(--radius);
    background: linear-gradient(117.2deg, rgba(34, 44, 60, 0.95) 0%, rgba(16, 21, 30, 0.95) 100%);
  }
  .person__photo {
    aspect-ratio: 464 / 500;
    overflow: hidden;
    background: #1b2433;
  }
  .person__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .person__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 32px 36px;
  }
  .person__role {
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 17px;
    letter-spacing: 0.05em;
    color: var(--steel);
  }
  /* Figma: Source Serif 4 Medium 28/32 */
  .person__name {
    font-family: var(--f-serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.35rem + 0.4vw, 1.75rem);
    line-height: 32px;
    letter-spacing: -0.5px;
    color: var(--paper);
  }
  .person__points {
    padding-top: 14px;
  }
  .person__points li {
    position: relative;
    padding: 12px 0 12px 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--t-small);
    line-height: 25px;
    color: #b7bac2; /* literal de Figma, entre --silver y --mist */
  }
  /* Viñeta: guion de 8 px en azul acero */
  .person__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 23px;
    width: 8px;
    height: 1px;
    background: var(--steel);
  }
  @media (hover: hover) {
    .person:hover .person__photo img {
      transform: scale(1.03);
    }
  }

  /* Entrada en cascada (solo con animaciones activas) */
  :global(html.motion) .founders__grid .person {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: calc(var(--i) * 140ms);
  }
  :global(html.motion) .founders__grid.is-in .person {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1180px) {
    .founders__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-bottom: 48px;
    }
    .founders__body {
      width: auto;
      max-width: 560px;
    }
    .person__text {
      padding: 24px 22px 28px;
    }
  }
  @media (max-width: 900px) {
    .founders__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }
</style>
