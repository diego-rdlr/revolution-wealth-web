---
// Banner de credenciales del hero ("40 años · 17 años · 0 · 100%").
// Animación (pedida en la llamada del 16-oct, ver docs/PENDIENTES.md):
// - Entrada: cada cifra sube y aparece en cascada mientras cuenta hasta su valor.
// - Hover: la línea de arriba se dibuja en dorado de izquierda a derecha y la cifra
//   cambia a dorado. Al quitar el cursor, la línea solo se desvanece (sin recorrido de vuelta).
// Todo vive en este archivo; sin animaciones (MOTION_ENABLED = false o "reducir
// movimiento") el banner queda estático como en Figma y el hover solo cambia el color.
interface Props {
  /** `count` es opcional: sin él la cifra no cuenta (p. ej. "∞" o "GBM"), solo entra en cascada. */
  /** `logo`: en lugar de la cifra va una imagen (p. ej. el logo de GBM); `value` queda como texto alternativo. */
  items: { value: string; count?: number; logo?: string; label: string }[];
}
const { items } = Astro.props;
---

<ul class="creds" data-reveal>
  {
    items.map((c, i) => (
      <li class="cred" style={`--i: ${i}`}>
        <span class="cred__bar" aria-hidden="true" />
        {
          c.logo ? (
            <span class="cred__value cred__value--logo">
              <img src={c.logo} alt={c.value} width="138" height="38" />
            </span>
          ) : (
            <span class="cred__value" data-count={c.count}>
              {c.value}
            </span>
          )
        }
        <span class="cred__label">{c.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .creds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-top: 50px;
  }
  .cred {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 0 36px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    cursor: default;
  }
  .cred:first-child {
    padding-left: 0;
    border-left: 0;
  }
  /* Línea superior: invisible como en Figma; en hover se llena de dorado de izquierda a derecha */
  .cred__bar {
    position: absolute;
    top: 0;
    left: 36px;
    right: 24px;
    height: 1px;
    overflow: hidden;
  }
  .cred:first-child .cred__bar {
    left: 0;
  }
  /* Al quitar el cursor: se desvanece en su lugar y, ya invisible, regresa a 0
     de ancho (el `0s 0.5s` de transform) para estar lista para el siguiente hover. */
  .cred__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0s linear 0.5s;
  }
  .cred__value {
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 1.9rem + 1.6vw, 3.75rem); /* 60/64 */
    line-height: 1.067;
    letter-spacing: -0.013em;
    white-space: nowrap;
    color: var(--paper);
    transition: color 0.35s ease;
  }
  /* Logo en lugar de cifra: misma altura de renglón (64 px), logo de 38 px centrado (Figma) */
  .cred__value--logo {
    display: flex;
    align-items: center;
    height: 1.067em;
  }
  .cred__value--logo img {
    width: auto;
    height: 0.633em;
  }
  .cred__label {
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--silver);
    transition: color 0.35s ease;
  }
  @media (hover: hover) {
    /* Al pasar el cursor: se dibuja con calma, frenando al final */
    .cred:hover .cred__bar::after {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.25s ease-out,
        transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cred:hover .cred__value {
      color: var(--gold);
    }
    .cred:hover .cred__label {
      color: var(--paper);
    }
  }

  /* Entrada: cascada de abajo hacia arriba (solo con animaciones activas) */
  :global(html.motion) .creds .cred {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: calc(var(--i) * 120ms);
  }
  :global(html.motion) .creds.is-in .cred {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 900px) {
    .creds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
      padding-top: 40px;
    }
    .cred:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .cred:nth-child(3) .cred__bar {
      left: 0;
    }
  }
  @media (max-width: 420px) {
    .cred {
      padding-left: 18px;
      padding-right: 8px;
    }
    .cred__bar {
      left: 18px;
      right: 8px;
    }
    .cred__label {
      font-size: 11px;
    }
  }
</style>
