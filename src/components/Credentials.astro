---
// Banner de credenciales del hero ("40 años · 17 años · 0 · 100%").
// Animación (pedida en la llamada del 16-oct, ver docs/PENDIENTES.md):
// - Entrada: cada cifra sube y aparece en cascada mientras cuenta hasta su valor.
// - Hover: la línea de arriba se llena de dorado y la cifra cambia a dorado.
// Todo vive en este archivo; sin animaciones (MOTION_ENABLED = false o "reducir
// movimiento") el banner queda estático como en Figma y el hover solo cambia el color.
interface Props {
  items: { value: string; count: number; label: string }[];
}
const { items } = Astro.props;
---

<ul class="creds" data-reveal>
  {
    items.map((c, i) => (
      <li class="cred" style={`--i: ${i}`}>
        <span class="cred__bar" aria-hidden="true" />
        <span class="cred__value" data-count={c.count}>
          {c.value}
        </span>
        <span class="cred__label">{c.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .creds {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-top: 50px;
  }
  .cred {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 0 36px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    cursor: default;
  }
  .cred:first-child {
    padding-left: 0;
    border-left: 0;
  }
  /* Línea superior: invisible como en Figma; en hover se llena de dorado de izquierda a derecha */
  .cred__bar {
    position: absolute;
    top: 0;
    left: 36px;
    right: 24px;
    height: 1px;
    overflow: hidden;
  }
  .cred:first-child .cred__bar {
    left: 0;
  }
  .cred__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .cred__value {
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 1.9rem + 1.6vw, 3.75rem); /* 60/64 */
    line-height: 1.067;
    letter-spacing: -0.013em;
    white-space: nowrap;
    color: var(--paper);
    transition: color 0.35s ease;
  }
  .cred__label {
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 17px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--silver);
    transition: color 0.35s ease;
  }
  @media (hover: hover) {
    .cred:hover .cred__bar::after {
      transform: none;
    }
    .cred:hover .cred__value {
      color: var(--gold);
    }
    .cred:hover .cred__label {
      color: var(--paper);
    }
  }

  /* Entrada: cascada de abajo hacia arriba (solo con animaciones activas) */
  :global(html.motion) .creds .cred {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
    transition-delay: calc(var(--i) * 120ms);
  }
  :global(html.motion) .creds.is-in .cred {
    opacity: 1;
    transform: none;
  }
  /* Al entrar, la línea dorada recorre una vez cada credencial y se retira */
  :global(html.motion) .creds.is-in .cred__bar::after {
    animation: cred-sweep 1.6s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    animation-delay: calc(var(--i) * 120ms + 200ms);
  }
  @keyframes cred-sweep {
    0% {
      transform: scaleX(0);
      transform-origin: left center;
    }
    55% {
      transform: scaleX(1);
      transform-origin: left center;
    }
    56% {
      transform-origin: right center;
    }
    100% {
      transform: scaleX(0);
      transform-origin: right center;
    }
  }
  @media (hover: hover) {
    :global(html.motion) .creds.is-in .cred:hover .cred__bar::after {
      animation: none;
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .creds {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
      padding-top: 40px;
    }
    .cred:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .cred:nth-child(3) .cred__bar {
      left: 0;
    }
  }
  @media (max-width: 420px) {
    .cred {
      padding-left: 18px;
      padding-right: 8px;
    }
    .cred__bar {
      left: 18px;
      right: 8px;
    }
    .cred__label {
      font-size: 11px;
    }
  }
</style>
