---
import { u } from '../config/base';
// Sección 12 · Comienza hoy (Figma 426:654). Cierre oscuro y centrado con foto,
// velo, resplandores (champán y dos azules) y grano. Lleva el botón primario.
import Kicker from './Kicker.astro';
import Title from './Title.astro';
import Button from './Button.astro';
import { comienza } from '../data/wealth';
---

<section id="comienza" class="section theme-dark comienza" aria-labelledby="comienza-title">
  <div class="atmos" aria-hidden="true">
    <img
      class="atmos__photo comienza__photo"
      data-parallax="0.1"
      src={u('/img/comienza-fondo-1600.webp')}
      srcset={u('/img/comienza-fondo-900.webp') + ' 900w' + ", " + u('/img/comienza-fondo-1600.webp') + ' 1600w'}
      sizes="100vw"
      alt=""
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
    <div class="atmos__veil comienza__veil"></div>
    <img class="comienza__champan" src={u('/img/comienza-resplandor-champan.webp')} alt="" width="700" height="700" loading="lazy" />
    <img class="comienza__glow comienza__glow--izq" src={u('/img/comienza-resplandor-izq.svg')} alt="" width="1040" height="840" loading="lazy" />
    <img class="comienza__glow comienza__glow--der" src={u('/img/comienza-resplandor-der.svg')} alt="" width="1040" height="840" loading="lazy" />
    <div class="comienza__grain"></div>
  </div>

  <div class="container comienza__content">
    <Kicker text={comienza.kicker} />
    <div id="comienza-title">
      <Title lines={comienza.title} size="h1" class="comienza__title" />
    </div>
    <p class="t-lead comienza__lede" data-reveal>{comienza.lede}</p>
    <div class="comienza__cta" data-reveal>
      <Button href={comienza.cta.href} label={comienza.cta.label} />
    </div>
    <p class="t-micro comienza__note" data-reveal>{comienza.note}</p>
  </div>
</section>

<style>
  .comienza {
    padding-block: 110px 81px;
  }
  .comienza__photo {
    opacity: 0.95;
  }
  .comienza__veil {
    background: linear-gradient(180deg, rgba(11, 15, 22, 0.4), rgba(10, 10, 10, 0.1) 50%, rgba(11, 15, 22, 0.85));
  }
  /* Resplandor champán: caja 1100×900 en (250, 250), opacidad 0.7 × 0.26 */
  .comienza__champan {
    position: absolute;
    left: calc(50% - 800px + 250px);
    top: 250px;
    width: 1100px;
    height: 900px;
    max-width: none;
    object-fit: cover;
    opacity: 0.18;
  }
  /* Resplandores azules (SVG de Figma con su desenfoque) */
  .comienza__glow {
    position: absolute;
    width: 1040px;
    max-width: none;
  }
  .comienza__glow--izq {
    left: calc(50% - 800px - 20px);
    top: -130px;
  }
  .comienza__glow--der {
    left: calc(50% - 800px + 630px);
    top: 130px;
  }
  .comienza__grain {
    position: absolute;
    inset: 0;
    opacity: 0.05;
    mix-blend-mode: overlay;
    background: url('/img/grano.png') top left / 50px 50px;
  }

  .comienza__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }
  .comienza__title {
    max-width: 1100px;
    color: var(--paper);
    /* Sombra de Figma como filtro: con animaciones el text-shadow sale recortado */
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.18)) drop-shadow(0 4px 24px rgba(0, 0, 0, 0.3));
  }
  .comienza__lede {
    max-width: 760px;
    color: var(--silver);
  }
  .comienza__cta {
    padding-top: 16px;
  }
  .comienza__note {
    color: var(--mist);
  }

  /* La puerta de luz "respira" muy lento: es el único movimiento continuo del sitio */
  :global(html.motion) .comienza__champan {
    animation: comienza-luz 7s ease-in-out infinite alternate;
  }
  @keyframes comienza-luz {
    from {
      opacity: 0.14;
      scale: 0.97;
    }
    to {
      opacity: 0.26;
      scale: 1.04;
    }
  }

  @media (max-width: 1180px) {
    .comienza {
      padding-block: var(--section-y);
    }
  }
  @media (max-width: 600px) {
    .comienza__content {
      gap: 24px;
    }
    .comienza__cta {
      width: 100%;
      padding-top: 8px;
    }
    .comienza__cta :global(.btn) {
      width: 100%;
      justify-content: center;
      white-space: normal;
      text-align: center;
      height: auto;
      min-height: 46px;
      padding-block: 12px;
    }
    .comienza__note {
      max-width: 300px;
    }
  }
</style>
