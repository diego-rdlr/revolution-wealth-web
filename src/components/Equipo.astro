---
// 07b · Equipo (Figma 538:490): carrusel de asesores.
// La lista vive en src/data/wealth.ts (una línea por persona).
// Carrusel = scroll horizontal nativo con "snap" (swipe táctil gratis) + un JS
// mínimo para flechas, contador, puntos, teclado y arrastre con mouse.
// Sin JS sigue funcionando: se desliza con el dedo o con la barra del trackpad.
import Kicker from './Kicker.astro';
import { equipo } from '../data/wealth';

const total = equipo.personas.length;
const pad = (n: number) => String(n).padStart(2, '0');
// Estado inicial en escritorio (5 tarjetas a la vista); el JS lo recalcula.
const porPagina = Math.min(5, total);
const paginas = Math.ceil(total / porPagina);
---

<section id="equipo" class="section theme-light equipo" aria-labelledby="equipo-title">
  <div class="container">
    <div class="equipo__top">
      <Kicker text={equipo.kicker} line={false} />
      <p class="equipo__tag">{equipo.tag}</p>
    </div>
    <h2 class="t-h2 title equipo__title" id="equipo-title" data-reveal>
      <span class="title__line"><span class="title__in">{equipo.title}</span></span>
    </h2>
    <p class="equipo__lede" data-reveal>{equipo.lede}</p>
  </div>

  <div class="carrusel" data-carrusel>
    <div
      class="carrusel__pista"
      tabindex="0"
      role="region"
      aria-roledescription="carrusel"
      aria-label={`${equipo.title} Usa las flechas del teclado para avanzar.`}
      data-pista
    >
      <ul class="carrusel__lista" data-lista>
      {
        equipo.personas.map((p) => (
          <li class="persona lift">
            <div class="persona__foto">
              {p.foto ? (
                <img src={p.foto} alt={p.nombre} width="460" height="460" loading="lazy" decoding="async" draggable="false" />
              ) : (
                <span class="persona__pendiente">{equipo.placeholder}</span>
              )}
            </div>
            <p class="persona__nombre">{p.nombre}</p>
            <p class="persona__puesto">{p.puesto}</p>
            <span class="persona__linea" aria-hidden="true" />
          </li>
        ))
      }
      </ul>
    </div>

    <div class="container carrusel__controles">
      <p class="carrusel__contador" aria-live="polite" data-contador>
        {`${pad(1)}–${pad(porPagina)} / ${pad(total)}`}
      </p>
      <div class="carrusel__puntos" data-puntos>
        {
          Array.from({ length: paginas }, (_, i) => (
            <button
              type="button"
              class="carrusel__punto"
              aria-label={`Página ${i + 1} de ${paginas}`}
              aria-current={i === 0 ? 'true' : undefined}
            />
          ))
        }
      </div>
      <div class="carrusel__flechas">
        <button type="button" class="carrusel__flecha" aria-label="Anteriores" data-prev disabled>
          <img src="/img/equipo-chevron-izq.svg" alt="" width="7.6" height="13.6" />
        </button>
        <button type="button" class="carrusel__flecha" aria-label="Siguientes" data-next>
          <img src="/img/equipo-chevron-der.svg" alt="" width="7.6" height="13.6" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');

  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((root) => {
    const pista = root.querySelector<HTMLElement>('[data-pista]')!;
    const tarjetas = Array.from(root.querySelector('[data-lista]')!.children) as HTMLElement[];
    const contador = root.querySelector<HTMLElement>('[data-contador]')!;
    const puntos = root.querySelector<HTMLElement>('[data-puntos]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const total = tarjetas.length;
    const molde = puntos.firstElementChild!;
    if (!total) return;

    // Medidas: paso = ancho de tarjeta + separación; cuántas caben completas.
    const medir = () => {
      const paso = tarjetas.length > 1 ? tarjetas[1].offsetLeft - tarjetas[0].offsetLeft : tarjetas[0].offsetWidth;
      const visible = pista.clientWidth - tarjetas[0].offsetLeft;
      const porPagina = Math.max(1, Math.min(total, Math.floor((visible + (paso - tarjetas[0].offsetWidth)) / paso)));
      return { paso, porPagina, paginas: Math.ceil(total / porPagina) };
    };

    let m = medir();
    const primera = () => Math.min(total - 1, Math.max(0, Math.round(pista.scrollLeft / m.paso)));
    const alFinal = () => pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - 2;
    const irA = (indice: number) => {
      const i = Math.max(0, Math.min(total - 1, indice));
      pista.scrollTo({ left: tarjetas[i].offsetLeft - tarjetas[0].offsetLeft, behavior: 'smooth' });
    };

    const pintarPuntos = () => {
      if (puntos.children.length === m.paginas) return;
      puntos.replaceChildren(
        ...Array.from({ length: m.paginas }, (_, i) => {
          // se clona un punto del HTML para conservar los estilos con alcance de Astro
          const b = molde.cloneNode() as HTMLButtonElement;
          b.removeAttribute('aria-current');
          b.setAttribute('aria-label', `Página ${i + 1} de ${m.paginas}`);
          return b;
        }),
      );
    };

    const actualizar = () => {
      const fin = alFinal();
      const desde = fin ? Math.max(0, total - m.porPagina) : primera();
      const hasta = Math.min(total, desde + m.porPagina);
      contador.textContent = `${hasta - desde > 1 ? `${pad(desde + 1)}–${pad(hasta)}` : pad(desde + 1)} / ${pad(total)}`;
      const pagina = fin ? m.paginas - 1 : Math.min(m.paginas - 1, Math.round(desde / m.porPagina));
      Array.from(puntos.children).forEach((b, i) => {
        if (i === pagina) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      prev.disabled = pista.scrollLeft <= 2;
      next.disabled = fin;
    };

    prev.addEventListener('click', () => irA(primera() - m.porPagina));
    next.addEventListener('click', () => irA(primera() + m.porPagina));
    puntos.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      irA(Array.from(puntos.children).indexOf(b) * m.porPagina);
    });

    // Teclado: ← → avanzan una tarjeta; Inicio/Fin van a los extremos.
    pista.addEventListener('keydown', (e) => {
      const mapa: Record<string, number> = { ArrowLeft: primera() - 1, ArrowRight: primera() + 1, Home: 0, End: total - 1 };
      if (!(e.key in mapa)) return;
      e.preventDefault();
      irA(mapa[e.key]);
    });

    // Arrastre con mouse (en táctil el swipe ya es nativo).
    let arrastre: { x: number; left: number; movio: boolean } | null = null;
    pista.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      arrastre = { x: e.clientX, left: pista.scrollLeft, movio: false };
    });
    window.addEventListener('pointermove', (e) => {
      if (!arrastre) return;
      const dx = e.clientX - arrastre.x;
      if (!arrastre.movio && Math.abs(dx) < 4) return;
      arrastre.movio = true;
      pista.classList.add('is-arrastrando');
      pista.scrollLeft = arrastre.left - dx;
    });
    window.addEventListener('pointerup', () => {
      if (!arrastre) return;
      const movio = arrastre.movio;
      arrastre = null;
      if (!movio) return;
      const cerca = primera();
      pista.classList.remove('is-arrastrando');
      irA(cerca);
    });

    let raf = 0;
    pista.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(actualizar);
    }, { passive: true });
    new ResizeObserver(() => {
      m = medir();
      pintarPuntos();
      actualizar();
    }).observe(pista);
  });
</script>

<style>
  .equipo {
    /* Figma: esta sección arranca pegada a la anterior (44 px arriba, 76 abajo) */
    padding-block: 44px 76px;
  }
  .equipo__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line);
  }
  /* Kicker en gris pizarra (#4e525e) y sin línea, como en Figma */
  .equipo__top :global(.kicker) {
    color: var(--slate);
  }
  .equipo__tag {
    font-family: var(--f-mono);
    font-size: 9px;
    line-height: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .equipo__title {
    margin-top: 49px;
    font-weight: 400; /* Feature Display Regular */
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.6875rem); /* 59/62 */
    line-height: 1.05;
  }
  .equipo__lede {
    max-width: 1000px;
    margin-top: 26px;
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem); /* 24/28 */
    line-height: 1.167;
    color: var(--slate);
  }

  /* ——— Carrusel ——— */
  .carrusel {
    margin-top: 28px;
  }
  .carrusel__pista {
    /* La pista ocupa todo el ancho; el padding la alinea con el contenedor
       y las tarjetas se asoman por la derecha, como en Figma */
    --borde: max(var(--gutter), calc((100% - var(--content)) / 2));
    position: relative;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--borde);
    scrollbar-width: none;
    cursor: grab;
    margin-block: -4px -22px;
  }
  .carrusel__lista {
    display: flex;
    gap: 24px;
    width: max-content;
    /* Aire extra arriba y abajo para que la elevación y la sombra del hover no se corten
       (el margen negativo de la pista lo compensa y el diseño no se mueve) */
    padding: 12px var(--borde) 40px;
  }
  .carrusel__pista::-webkit-scrollbar {
    display: none;
  }
  .carrusel__pista:focus-visible {
    outline-offset: -2px;
  }
  .carrusel__pista.is-arrastrando {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  .persona {
    flex: none;
    display: flex;
    flex-direction: column;
    width: 269px;
    min-height: 412px;
    padding: 19px 19px 40px;
    scroll-snap-align: start;
    border: 1px solid var(--silver);
    border-radius: var(--radius);
    background: linear-gradient(123.14deg, #ffffff 0%, #edeff3 73.53%);
    box-shadow:
      0 12px 14px rgba(41, 46, 56, 0.06),
      0 2px 3px rgba(41, 46, 56, 0.07);
  }
  .persona__foto {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: #edeff3; /* Figma: fondo de "FOTO PENDIENTE" */
  }
  .persona__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .persona__pendiente {
    font-family: var(--f-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: #878a94; /* Figma: gris del placeholder */
  }
  /* Figma: el nombre se ve en sans (Geist) aunque su estilo diga Feature; se sigue lo que se ve */
  .persona__nombre {
    min-height: 64px; /* dos renglones: los puestos quedan alineados */
    margin-top: 6px;
    font-family: var(--f-body);
    font-weight: 400;
    font-size: 30px;
    line-height: 32px;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .persona__puesto {
    margin-top: 8px;
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #787b83; /* Figma: gris del puesto (no hay token) */
  }
  .persona__linea {
    width: 86px;
    height: 1px;
    margin-top: 12px;
    background: var(--gold);
  }

  /* ——— Controles: contador · puntos · flechas ——— */
  .carrusel__controles {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .carrusel__contador {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0.26em;
    white-space: nowrap;
    color: var(--slate);
  }
  .carrusel__puntos {
    display: flex;
    gap: 8px;
  }
  .carrusel__punto {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--silver);
    cursor: pointer;
    transition:
      width 0.3s ease,
      background 0.3s ease;
  }
  /* Área de toque más grande que el punto */
  .carrusel__punto {
    position: relative;
  }
  .carrusel__punto::after {
    content: '';
    position: absolute;
    inset: -10px -4px;
  }
  .carrusel__punto[aria-current='true'] {
    width: 28px;
    background: var(--gold-ink);
  }
  .carrusel__flechas {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
  }
  .carrusel__flecha {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--silver);
    border-radius: 50%;
    background: #ffffff;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }
  .carrusel__flecha:hover:not(:disabled) {
    border-color: var(--navy);
  }
  .carrusel__flecha:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Entrada: las tarjetas suben en cascada (solo con animaciones activas) */
  :global(html.motion) .equipo__lede {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1) 0.2s,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) 0.2s;
  }
  :global(html.motion) .equipo__lede.is-in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 600px) {
    .equipo {
      padding-block: 36px 56px;
    }
    .equipo__title {
      margin-top: 36px;
    }
    .equipo__lede {
      margin-top: 16px;
    }
    .carrusel__lista {
      gap: 16px;
    }
    .persona {
      width: min(269px, 74vw);
      min-height: 0;
      padding-bottom: 28px;
    }
    .carrusel__controles {
      grid-template-columns: 1fr auto;
      margin-top: 16px;
    }
    .carrusel__contador {
      font-size: 13px;
      letter-spacing: 0.16em;
    }
    .carrusel__puntos {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
    }
  }
</style>
