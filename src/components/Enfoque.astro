---
// 08 · Nuestro enfoque (Figma 425:606): misión + 3 principios
// (Criterio · Disciplina · Paz mental) en tarjetas claras.
import Kicker from './Kicker.astro';
import Title from './Title.astro';
import { enfoque } from '../data/wealth';
---

<section id="enfoque" class="section theme-light enfoque" aria-labelledby="enfoque-title">
  <div class="container enfoque__inner">
    <Kicker text={enfoque.kicker} />
    <div id="enfoque-title">
      <Title lines={enfoque.title} class="enfoque__title" />
    </div>

    <div class="enfoque__mision" data-reveal>
      <p class="enfoque__lema">{enfoque.mision}</p>
      <p class="t-lead enfoque__body">{enfoque.body}</p>
    </div>

    <ol class="enfoque__principios" data-reveal>
      {
        enfoque.principios.map((p, i) => (
          <li class="card principio lift" style={`--i: ${i}`}>
            <span class="principio__acento" aria-hidden="true" />
            <span class="principio__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="principio__title">{p.title}</h3>
            <p class="t-small principio__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .enfoque {
    --bg: #e6edf2; /* Figma: fondo claro azulado (no hay token) */
    padding-block: clamp(3rem, 2.5rem + 1.2vw, 3.8125rem) var(--section-y); /* 61 / 150 */
  }
  .enfoque__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 56px;
  }
  /* Display Regular 59/62 (más grande que el H2 de sección) */
  .enfoque :global(.enfoque__title) {
    max-width: 1300px;
    font-weight: 400;
    font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.6875rem);
    line-height: 1.05;
  }

  .enfoque__mision {
    display: grid;
    grid-template-columns: 560px minmax(0, 1fr);
    gap: 120px;
    width: 100%;
    padding-top: 40px;
    border-top: 1px solid var(--steel);
  }
  .enfoque__lema {
    /* Figma: Source Serif 4 Medium 28/32 */
    font-family: var(--f-serif);
    font-weight: 500;
    font-size: clamp(1.5rem, 1.35rem + 0.5vw, 1.75rem);
    line-height: 1.143;
    color: var(--ink);
  }
  .enfoque__body {
    font-weight: 300;
    color: var(--slate);
  }

  .enfoque__principios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    padding-top: 16px;
  }
  .principio {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 32px 32px;
    background: linear-gradient(156.58deg, #ffffff 0%, #edeff3 100%);
  }
  .principio__acento {
    position: absolute;
    top: -1px;
    left: 31px;
    width: 48px;
    height: 3px;
    background: var(--steel);
  }
  .principio__num {
    font-family: var(--f-mono);
    font-size: 11px;
    line-height: 17px;
    letter-spacing: 0.05em;
    color: var(--navy);
  }
  .principio__title {
    font-family: var(--f-display);
    font-weight: 300;
    font-size: clamp(2.125rem, 1.8rem + 1vw, 2.625rem); /* 42/48 */
    line-height: 1.143;
    letter-spacing: -0.019em;
    color: var(--ink);
  }
  .principio__text {
    color: var(--slate);
  }

  /* Entrada: misión y tarjetas suben en cascada (solo con animaciones activas) */
  :global(html.motion) .enfoque__mision,
  :global(html.motion) .enfoque .principio {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  :global(html.motion) .enfoque .principio {
    /* Retraso solo para la entrada; la elevación del hover (.lift) responde al instante */
    transition:
      opacity 0.8s cubic-bezier(0.2, 0.7, 0.1, 1) calc(var(--i) * 120ms),
      transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) calc(var(--i) * 120ms),
      translate 0.6s cubic-bezier(0.2, 0.7, 0.1, 1),
      box-shadow 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  :global(html.motion) .enfoque__mision.is-in,
  :global(html.motion) .enfoque__principios.is-in .principio {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1180px) {
    .enfoque__mision {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
  @media (max-width: 900px) {
    .enfoque__inner {
      gap: 40px;
    }
    .enfoque__principios {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-top: 0;
    }
    .principio {
      padding: 24px;
    }
    .principio__acento {
      left: 23px;
    }
  }
</style>
