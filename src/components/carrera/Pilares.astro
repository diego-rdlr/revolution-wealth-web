---
// Tarjetas de papel de la subpágina /carrera ("Lo que nos distingue" y "Beneficios").
// Mismo lenguaje que los pilares de "Invierte con expertos": acento azul arriba,
// número + ícono, titular y texto. Figma: título en Feature Display Light 30/32.
interface Props {
  items: { title: string; text: string; icon: string }[];
}
const { items } = Astro.props;
---

<ul class="cpilares" data-reveal style={`--cols: ${items.length}`}>
  {
    items.map((p, i) => (
      <li class="cpilar" style={`--i: ${i}`}>
        <span class="cpilar__acento" aria-hidden="true" />
        <div class="cpilar__cabecera">
          <span class="cpilar__num">{String(i + 1).padStart(2, '0')}</span>
          <img class="cpilar__icono" src={p.icon} alt="" width="44" height="44" loading="lazy" />
        </div>
        <h3 class="cpilar__titulo">{p.title}</h3>
        <p class="cpilar__texto">{p.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .cpilares {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px;
  }
  .cpilar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 32px 36px;
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    background: linear-gradient(155deg, #ffffff, #edeff3);
    box-shadow: var(--card-shadow);
  }
  .cpilar__acento {
    position: absolute;
    top: -1px;
    left: 31px;
    width: 48px;
    height: 3px;
    background: var(--steel);
  }
  .cpilar__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 40px;
  }
  .cpilar__num {
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    line-height: 17px;
    letter-spacing: 0.05em;
    color: var(--navy);
  }
  .cpilar__icono {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }
  /* Figma: estas capas se ven en sans (Geist) aunque su estilo diga Feature; se sigue lo que se ve */
  .cpilar__titulo {
    font-family: var(--f-body);
    font-weight: 400;
    font-size: clamp(1.375rem, 1.2rem + 0.55vw, 1.875rem); /* 30/32 */
    line-height: 1.067;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .cpilar__texto {
    font-size: var(--t-small);
    line-height: 1.667;
    color: var(--slate);
  }

  :global(html.motion) .cpilares .cpilar {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(var(--i) * 110ms);
  }
  :global(html.motion) .cpilares.is-in .cpilar {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1024px) {
    .cpilares {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  @media (max-width: 600px) {
    .cpilar {
      padding: 28px 24px 30px;
    }
    .cpilar__acento {
      left: 23px;
    }
    .cpilar__cabecera {
      padding-bottom: 20px;
    }
  }
</style>
