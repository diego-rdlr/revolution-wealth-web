---
import { brand } from '../data/wealth';

interface Props {
  /** Muestra "Asesor afiliado a GBM" junto al logo (solo en el menú). */
  tagline?: boolean;
}
const { tagline = true } = Astro.props;
---

<a class="brand" href="/" aria-label={brand.name}>
  <img class="brand__logo" src="/img/logo-rwm-blanco.png" alt="" width="201" height="20" />
  {
    tagline && (
      <>
        <span class="brand__divider" aria-hidden="true" />
        <span class="brand__tagline">{brand.tagline}</span>
      </>
    )
  }
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px; /* área táctil cómoda */
    text-decoration: none;
    white-space: nowrap;
  }
  .brand__logo {
    width: 201px;
    height: 20px;
    object-fit: contain;
  }
  .brand__divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.2);
  }
  .brand__tagline {
    font-family: var(--f-mono);
    font-size: var(--t-nav);
    line-height: 16px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
  }
  @media (max-width: 760px) {
    .brand__divider,
    .brand__tagline {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .brand__logo {
      width: 170px;
      height: 17px;
    }
  }
</style>
