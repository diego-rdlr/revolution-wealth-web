---
import { u } from '../config/base';
import { brand } from '../data/wealth';

interface Props {
  /** Muestra "Asesor afiliado a GBM" junto al logo (solo en el menú). */
  tagline?: boolean;
}
const { tagline = true } = Astro.props;
---

<a class="brand" href={u('/')} aria-label={`${brand.name}, ${brand.tagline} GBM`}>
  <img class="brand__logo" src={u('/img/logo-rwm-blanco.png')} alt="" width="201" height="20" />
  {
    tagline && (
      <>
        <span class="brand__divider" aria-hidden="true" />
        <span class="brand__tagline">
          {brand.tagline}
          <img class="brand__gbm" src={u('/img/logo-gbm.svg')} alt="GBM" width="54" height="15" />
        </span>
      </>
    )
  }
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px; /* área táctil cómoda */
    text-decoration: none;
    white-space: nowrap;
  }
  .brand__logo {
    width: 201px;
    height: 20px;
    object-fit: contain;
  }
  .brand__divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.2);
  }
  .brand__tagline {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--f-mono);
    font-size: var(--t-nav);
    line-height: 16px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
  }
  /* En laptops (1181–1500 px) el menú completo no cabe junto a la etiqueta: se oculta */
  .brand__gbm {
    width: 54px;
    height: 15px;
  }
  @media (max-width: 1500px) and (min-width: 1181px), (max-width: 760px) {
    .brand__divider,
    .brand__tagline {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .brand__logo {
      width: 170px;
      height: 17px;
    }
  }
</style>
