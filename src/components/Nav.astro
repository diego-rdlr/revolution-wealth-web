---
// Header de Revolution Wealth, armonizado con el de revolution.inc (21-oct):
// mismas medidas (57 px), vidrio, tipografía y botones (Media · Education · Wealth · Capital · Nosotros),
// con la marca de Wealth (isotipo Ø → revolution.inc, logo + "Asesor afiliado a GBM") y su CTA.
// En celular (≤ 980 px) usa el botón de texto "Menú" de revolution.inc; el CTA va dentro del menú.
import Brand from './Brand.astro';
import Button from './Button.astro';
import { inc, nav } from '../data/wealth';
---

<header class="nav" data-nav>
  <div class="nav__wrap">
    <Brand />
    <nav class="nav__links" id="nav-links" aria-label="Revolution Inc." data-nav-links>
      {
        inc.nav.map((l) => (
          <a href={l.href} aria-current={l.actual ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <span class="nav__menu-cta">
        <Button href={nav.cta.href} label={nav.cta.label} />
      </span>
    </nav>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-nav-toggle>Menú</button>
    <span class="nav__cta">
      <Button href={nav.cta.href} label={nav.cta.label} class="nav__btn" />
    </span>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const links = document.querySelector<HTMLElement>('[data-nav-links]');
  if (btn && links) {
    const setOpen = (open: boolean) => {
      links.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(!links.classList.contains('open')));
    links.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    matchMedia('(min-width: 981px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  /* Medidas y colores de revolution.inc/assets/css/sitio.css (.nav) */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    padding-top: env(safe-area-inset-top);
    background: rgba(10, 10, 10, 0.66);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #242832;
  }
  .nav__wrap {
    max-width: 1600px;
    height: 100%;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 80px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.1vw, 2.1rem);
  }
  .nav__links a {
    font-family: var(--f-mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mist);
    text-decoration: none;
    transition: color 0.25s cubic-bezier(0.2, 0, 0, 1);
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--paper);
  }
  .nav__menu-cta {
    display: none;
  }
  /* CTA de Wealth con la altura del de revolution.inc (34 px) */
  .nav__cta {
    flex: none;
  }
  .nav__cta :global(.nav__btn) {
    height: 34px;
    padding: 0 18px;
  }
  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper);
    padding: 0.75rem 0;
  }

  @media (max-width: 980px) {
    .nav {
      background: rgba(10, 10, 10, 0.97);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .nav__links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem clamp(20px, 5vw, 80px) 1.5rem;
      background: var(--ink); /* sólido: el texto del hero no se debe ver detrás */
      border-bottom: 1px solid #242832;
      display: none;
    }
    .nav__links:global(.open) {
      display: flex;
    }
    .nav__toggle {
      display: inline-flex;
      margin-left: auto;
    }
  }
  /* Celulares: el CTA sale de la barra y entra al menú desplegable */
  @media (max-width: 520px) {
    .nav__cta {
      display: none;
    }
    .nav__menu-cta {
      display: block;
      width: 100%;
      padding-top: 0.5rem;
    }
    .nav__menu-cta :global(.btn) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
