---
// Sección 10 · Preguntas frecuentes (Figma 426:536). Tema claro.
// Izquierda: titular + tarjeta de contacto. Derecha: acordeón con <details>/<summary>
// (funciona con teclado y sin JavaScript). La 01 va abierta, como en el diseño.
// Las preguntas sin respuesta en src/data/wealth.ts no se pintan.
import Kicker from './Kicker.astro';
import Title from './Title.astro';
import Button from './Button.astro';
import { preguntas } from '../data/wealth';

// Se conserva el número original de cada pregunta aunque falten respuestas
const items = preguntas.items
  .map((it, i) => ({ ...it, num: String(i + 1).padStart(2, '0') }))
  .filter((it) => it.respuesta.trim() !== '');

// Datos estructurados para buscadores (FAQPage), solo con las que tienen respuesta
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: it.respuesta },
  })),
};
---

<section id="preguntas" class="section theme-light faq" aria-labelledby="preguntas-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <Kicker text={preguntas.kicker} />
      <div id="preguntas-title">
        <Title lines={preguntas.title} inline />
      </div>
      <p class="t-body faq__lede" data-reveal>{preguntas.lede}</p>

      <aside class="contact" aria-labelledby="preguntas-contacto" data-reveal>
        <p class="t-micro contact__kicker">{preguntas.contacto.kicker}</p>
        <h3 class="contact__title" id="preguntas-contacto">{preguntas.contacto.title}</h3>
        <p class="t-small contact__text">{preguntas.contacto.text}</p>
        <div class="contact__cta">
          <Button href={preguntas.contacto.cta.href} label={preguntas.contacto.cta.label} />
        </div>
      </aside>
    </div>

    <div class="faq__list" data-faq>
      {
        items.map((it, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__row">
              <span class="faq__num" aria-hidden="true">
                {it.num}
              </span>
              <span class="faq__q">{it.pregunta}</span>
              <span class="faq__icon" aria-hidden="true">
                <img class="faq__icon-mas" src="/img/preguntas-icono-mas.svg" alt="" width="36" height="36" />
                <img class="faq__icon-menos" src="/img/preguntas-icono-menos.svg" alt="" width="36" height="36" />
              </span>
            </summary>
            <div class="faq__answer">
              <p>{it.respuesta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<script>
  // Apertura suave del acordeón: anima la altura del contenido.
  // Solo con animaciones activas (html.motion); si no, <details> abre y cierra al instante.
  const root = document.documentElement;
  document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((el) => {
    const summary = el.querySelector('summary');
    const body = el.querySelector<HTMLElement>('.faq__answer');
    if (!summary || !body) return;
    let anim: Animation | null = null;

    summary.addEventListener('click', (e) => {
      if (!root.classList.contains('motion')) return;
      e.preventDefault();
      anim?.cancel();
      const opening = !el.open;
      if (opening) el.open = true;
      const h = body.scrollHeight;
      el.classList.toggle('is-closing', !opening);
      anim = body.animate(
        opening
          ? [{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }]
          : [{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
        { duration: opening ? 420 : 320, easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)' },
      );
      anim.onfinish = () => {
        if (!opening) el.open = false;
        el.classList.remove('is-closing');
        anim = null;
      };
    });
  });
</script>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: 440px minmax(0, 1fr);
    gap: 100px;
    align-items: start;
  }
  .faq__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .faq__lede {
    padding-bottom: 40px; /* "Espacio" de Figma (12) + separación (28) */
  }

  /* Tarjeta "¿Tienes otra pregunta?": vidrio azulado claro (colores literales de Figma) */
  .contact {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 30px 32px 32px;
    border: 1px solid #b8ccd8; /* Figma: borde de la tarjeta, sin token */
    border-radius: var(--radius);
    background: linear-gradient(146.34deg, #eef3f6, #d5e1e8); /* Figma: sin token */
    box-shadow: var(--shadow-card);
  }
  .contact__kicker {
    color: var(--gold-ink);
  }
  /* Figma pide Source Serif 4 Medium 28/32; se usa la display del sitio */
  .contact__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.143;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .contact__text {
    color: var(--slate);
  }
  .contact__cta {
    padding-top: 10px;
  }

  /* ——— Acordeón ——— */
  .faq__item {
    border-top: 1px solid var(--silver);
    transition: border-color 0.3s ease;
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--silver);
  }
  .faq__item[open]:not(.is-closing) {
    border-top-color: var(--navy);
  }
  .faq__row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 24px;
    list-style: none;
    cursor: pointer;
  }
  .faq__row::-webkit-details-marker {
    display: none;
  }
  .faq__row:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 4px;
  }
  .faq__num {
    flex: none;
    width: 28px;
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    line-height: 17px;
    letter-spacing: 0.05em;
    color: var(--gray);
    transition: color 0.3s ease;
  }
  .faq__q {
    flex: 1;
    min-width: 0;
    font-size: var(--t-lead);
    line-height: 1.304;
    color: #1b1f27; /* Figma: texto de pregunta cerrada, sin token */
    transition: color 0.3s ease;
  }
  .faq__item[open]:not(.is-closing) .faq__num {
    color: var(--gold-ink);
  }
  .faq__item[open]:not(.is-closing) .faq__q {
    color: var(--ink);
  }
  .faq__row:hover .faq__q {
    color: var(--ink);
  }

  /* Ícono: el "más" y el "menos" de Figma, uno encima del otro */
  .faq__icon {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
  }
  .faq__icon img {
    position: absolute;
    inset: 0;
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .faq__icon-menos {
    opacity: 0;
    transform: rotate(-90deg);
  }
  .faq__item[open]:not(.is-closing) .faq__icon-menos {
    opacity: 1;
    transform: none;
  }
  .faq__item[open]:not(.is-closing) .faq__icon-mas {
    opacity: 0;
    transform: rotate(90deg);
  }

  .faq__answer {
    overflow: hidden;
    margin-top: -10px; /* Figma: 14 entre fila y respuesta, en vez de los 24 del padding */
  }
  .faq__answer p {
    padding: 0 60px 24px 52px;
    font-size: var(--t-base);
    line-height: 1.647;
    color: var(--slate);
  }

  @media (max-width: 1180px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
    .faq__head {
      max-width: 640px;
    }
    .faq__lede {
      padding-bottom: 12px;
    }
  }
  @media (max-width: 600px) {
    .contact {
      padding: 24px 20px;
    }
    .contact__title {
      font-size: 1.5rem;
    }
    .contact__cta,
    .contact__cta :global(.btn) {
      width: 100%;
      justify-content: center;
    }
    .faq__row {
      gap: 14px;
      padding-block: 20px;
    }
    .faq__num {
      width: 20px;
    }
    .faq__q {
      font-size: 1.125rem;
    }
    .faq__answer p {
      padding: 0 0 20px 34px;
      font-size: var(--t-small);
      line-height: 1.667;
    }
  }
</style>
