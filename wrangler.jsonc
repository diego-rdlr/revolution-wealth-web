// Configuración de Cloudflare Workers (sitio estático).
// `npx wrangler deploy` primero corre `npm run build` (genera dist/, ver "build")
// y luego publica el contenido de dist/ como "static assets". Así el deploy
// funciona aunque el panel de Cloudflare no tenga un build command configurado.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revolution-wealth-web",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
